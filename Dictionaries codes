########################################  NESTED DICTIONARIES  ########################################

Favorite_people = {
    "7 people" : "From korea",
    "BTS": {
        "Kim Namjoon": ["Leader", "Rapper", "Songwriter"],
        "Kim Seokjin": ["Vocalist", "Visual"],
        "Min Yoongi": ["Rapper", "Songwriter", "Producer"],
        "Jung Hoseok": ["Dancer", "Rapper", "Songwriter"],
        "Park Jimin": ["Vocalist", "Dancer"],
        "Kim Taehyung": ["Vocalist", "Dancer", "Visual"],
        "Jeon Jungkook": ["Vocalist, Dancer"],
        
    }

}
print(Favorite_people)
print(Favorite_people["BTS"]["Kim Taehyung"])
print(Favorite_people["BTS"]["Kim Taehyung"][0])
print(Favorite_people["BTS"]["Kim Taehyung"][1])
print(Favorite_people["BTS"]["Kim Taehyung"][2])
print(Favorite_people["BTS"]["Kim Taehyung"][0:2]) #slicing the list of roles of Kim Taehyung
print(Favorite_people["BTS"]["Kim Taehyung"][1:3]) #slicing the list of roles of Kim Taehyung
print(Favorite_people["BTS"]) 

print(len(Favorite_people)) #length of the dictionary
print(len(Favorite_people["BTS"])) #length of the nested dictionary "BTS"
print(Favorite_people.keys()) #keys of the dictionary
print(Favorite_people.values()) #values of the dictionary
print(Favorite_people.items()) #key-value pairs of the dictionary
print(Favorite_people.get("BTS")) #using the get() method to access the value of the key "BTS"
print(Favorite_people.get("BTS").get("Kim Taehyung")) #using the get() method to access the value of the key "Kim Taehyung" in the nested dictionary "BTS"
print(Favorite_people.update({"7 Normal boys": "From korea"})) #updating the value of the key "7 people" to "7 Normal   boys"
print(Favorite_people)


