# CONDITIONAL STATEMENTS FOR GRADING SYSTEM

marks = float(input(" math : "))
marks2 = float(input(" science : "))
marks3 = float(input(" geography: "))
total = int(marks + marks2 + marks3)

print(f"Total marks: {total}")
avg = int(total / 3)
print(f"Average marks: {avg}")

if avg > 90:
    print("Grade A")
elif avg> 80 and avg <= 90:
    print("Grade B")
elif avg > 70 and avg <= 80:
    print("Grade C")
elif avg > 60 and avg <= 70:
    print("Grade D")
else:
    print("Grade F")


