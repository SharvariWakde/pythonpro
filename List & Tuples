 #basic logic of palindrome
 name = input("Enter your name: ")
 name1 =name

 name2 = name1[::-1]

 if name == name2:
     print(f"{name} is a palindrome")
 else:
     print(f"{name} is not a palindrome")

 list = [1,2,3,2,1]
 l1 = list.copy()
 l1.reverse()

 if list == l1:
     print(f"{list} is a palindrome")
 else:    print(f"{list} is not a palindrome")

 chars = ["M", "A","'", "A", "M"]

 if chars == chars[::-1]:
     print(f"{chars} is a palindrome")
 else:
     print(f"{chars} is not a palindrome")

